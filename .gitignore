.DS_Store
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
*.py[cod]
*.egg-info/
.coverage
htmlcov/
mlruns/
private/

# Large and mutable research outputs
artifacts/runs/*
!artifacts/runs/.gitkeep
artifacts/checkpoints/*
!artifacts/checkpoints/.gitkeep
artifacts/*.tar.gz
data/raw/
data/processed/
data/qlib/

# Real values used by a behavior replay stay on the research server.  Git keeps
# their hashes, request, receipt, manifests and reports only.
evidence/pit/behavior/packages/*/raw_before.json
evidence/pit/behavior/packages/*/raw_after.json
evidence/pit/behavior/packages/*/baseline_output.csv
evidence/pit/behavior/packages/*/probe_output.csv

# Secrets and local environment
.env
.env.*
!.env.example
*.pem
*.key

# Keep immutable governance files, manifests and receipts trackable.
